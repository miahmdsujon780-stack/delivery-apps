rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: deliveries
    // Document ID: auto-generated
    // Fields:
    //   - date: string (required, YYYY-MM-DD)
    //   - soName: string (required)
    //   - route: string (required)
    //   - tissue: number (required)
    //   - ballpen: number (required)
    //   - exbook: number (required)
    //   - userId: string (required, matches auth.uid)
    //   - timestamp: timestamp (required)
    //
    // Collection: users
    // Document ID: auth.uid
    // Fields:
    //   - name: string (required)
    //   - uniqueId: string (required)
    //   - role: string (required, 'so' or 'admin')
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ["miahmdsujon780@gmail.com", "mahbubasujon@gmail.com"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidDelivery(data) {
      return data.keys().hasAll(['date', 'soName', 'route', 'tissue', 'ballpen', 'exbook', 'userId', 'timestamp', 'soId']) &&
             data.date is string && data.date.size() == 10 &&
             data.soName is string && data.soName.size() > 0 &&
             data.route is string && data.route.size() > 0 &&
             data.tissue is number &&
             data.ballpen is number &&
             data.exbook is number &&
             data.userId == request.auth.uid;
    }

    function isUnchanged(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'uniqueId', 'role']) &&
             data.name is string &&
             data.uniqueId is string &&
             data.role in ['so', 'admin'];
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['date', 'soName', 'soId', 'userId', 'checkInTime', 'status', 'timestamp']) &&
             data.date is string &&
             data.userId == request.auth.uid &&
             data.status in ['On Time', 'Late', 'Absent'] &&
             data.timestamp is timestamp;
    }

    function isValidProductEntry(data) {
      return data.keys().hasAll(['date', 'productName', 'pieces', 'value', 'soName', 'soId', 'userId', 'timestamp']) &&
             data.date is string &&
             data.productName is string &&
             data.pieces is number &&
             data.value is number &&
             data.soName is string &&
             data.soId is string &&
             data.userId == request.auth.uid &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isValidUser(request.resource.data) && 
        request.resource.data.role == resource.data.role
      );
    }

    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidDelivery(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidAttendance(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /product_entries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidProductEntry(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /officers/{officerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/monthly_targets {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /officer_targets/{officerName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /assigned_locations/{officerName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
